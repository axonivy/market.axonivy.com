---
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";
import i18next, { type Lang } from "@/translation/ui";
import { getLanguageUrls } from "@/translation/urls";
import { DESIGNER_PARAMS } from "@/data/designer";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = i18next.getFixedT(lang);

interface Props {
  redirect?: boolean;
}

const { redirect = true } = Astro.props as Props;
---

<html lang={lang}>
  <head>
    {redirect && <script
      is:inline
      define:vars={{ urls: getLanguageUrls(Astro.url), lang }}
    >
      try {
        const saved = localStorage.getItem("lang");
        if (saved && saved !== lang && saved in urls) {
          location.replace(urls[saved] + location.search + location.hash);
        }
      } catch {
        // Storage blocked: stay on the current language.
      }
    </script>}
    <script is:inline define:vars={{ p: DESIGNER_PARAMS }}>
      const params = new URLSearchParams(location.search);
      let viewer = params.get(p.viewer);
      let version = params.get(p.version) ?? params.get(p.newVersion);
      try {
        if (viewer === p.designerViewer) {
          sessionStorage.setItem(p.viewer, viewer);
        } else {
          viewer = sessionStorage.getItem(p.viewer);
        }
        if (version !== null) {
          sessionStorage.setItem(p.version, version);
        } else {
          version = sessionStorage.getItem(p.version);
        }
      } catch {
        // Storage blocked: only the URL params count.
      }
      if (viewer === p.designerViewer) {
        document.documentElement.dataset.designer = version ?? "";
        if (params.has(p.restClient)) {
          document.documentElement.dataset.restClient = "";
        }
      }
    </script>
    <Font cssVariable="--font-inter" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{t("dashboard.title")}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="shrink-0 rest-client:hidden">
        <Header />
      </header>

      <div class="relative isolate flex-1 overflow-hidden">
        <div
          class:list={[
            "mx-auto flex min-h-[calc(100vh-4.5rem)] w-full flex-col px-4 pt-32 pb-20 md:max-w-6xl",
            "rest-client:min-h-0 rest-client:py-4",
          ]}
        >
          <slot />
        </div>
      </div>
    </div>

    <footer class="rest-client:hidden">
      <Footer />
    </footer>
  </body>
</html>
