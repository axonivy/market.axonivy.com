---
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";
import i18next, { type Lang } from "@/translation/ui";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = i18next.getFixedT(lang);
---

<html lang={lang}>
  <head>
    <Font cssVariable="--font-inter" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{t("dashboard.title")}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="shrink-0">
        <Header />
      </header>

      <div class="relative isolate flex-1 overflow-hidden">
        <div
          class:list={[
            "mx-auto flex min-h-[calc(100vh-4.5rem)] w-full flex-col px-4 pt-32 pb-20 md:max-w-6xl",
          ]}
        >
          <slot />
        </div>
      </div>
    </div>

    <footer>
      <Footer />
    </footer>
  </body>
</html>
