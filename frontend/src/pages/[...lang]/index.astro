---
import Products from "@/components/products";
import { Base, H1, H4 } from "@/components/ui/typography";
import { FILTER_VALUES } from "@/data/product-types";
import { getProductSummaries } from "@/data/products";
import Layout from "@/layouts/main.astro";
import i18next, { type Lang } from "@/translation/ui";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = i18next.getFixedT(lang);
const [beforeLink, linkText, afterLink] = t("dashboard.contribution").split(
  /<a>|<\/a>/,
);

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "de" } }];
}
---

<Layout>
  <div class="flex flex-col gap-8 designer:gap-0">
    <H1 className="designer:hidden">{t("dashboard.title")}</H1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <H4 className="max-w-5/6 designer:hidden">{t("dashboard.subtitle")}</H4>
      <Base className="text-n900 designer:hidden">
        {t("dashboard.description")}
        <br />
        {beforeLink}
        <a
          href="https://github.com/axonivy-market/market/wiki"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary underline"
        >
          {linkText}
        </a>
        {afterLink}
      </Base>
    </div>
  </div>
  <Products client:load products={getProductSummaries(lang)} lang={lang} />
  <script is:inline define:vars={{ filters: FILTER_VALUES }}>
    {
      const params = new URLSearchParams(location.search);
      let type = params.get("type");
      if (document.documentElement.dataset.restClient !== undefined) {
        type = "connector";
      } else if (!filters.includes(type)) {
        type = "all";
      }
      const q = (params.get("search") ?? "").trim().toLocaleLowerCase();
      for (const card of document.querySelectorAll("a[data-search]")) {
        const matches =
          (type === "all" || card.dataset.type === type) &&
          card.dataset.search
            .split("\n")
            .some((text) => text.toLocaleLowerCase().includes(q));
        card.hidden = !matches;
      }
    }
  </script>
</Layout>
