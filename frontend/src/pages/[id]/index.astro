---
import Layout from "@/layouts/main.astro";
import { getAllProducts, getProductById, TYPE_LABELS } from "@/data/products";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import { Base, H1, H3, H4, H5 } from "@/components/ui/typography";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import {
  IconClipboardCheck,
  IconPlug,
  IconTools,
  IconAlertTriangle,
} from "@tabler/icons-astro";
import DownloadProduct from "@/components/download-product";
import ProductDetails from "@/components/product-details";
import AxonIvyLogo from "@/assets/axonivy-logo-2021-rgb.svg";
import { Table, TableBody, TableCell, TableRow } from "@/components/ui/table";
import { loadReadme } from "@/data/readme";

export function getStaticPaths() {
  return getAllProducts().map((product) => ({ params: { id: product.id } }));
}

const { id } = Astro.params;
const product = getProductById(id);

if (!product) {
  return Astro.redirect("/404");
}

const readme = product.readme ? await loadReadme(product.readme) : undefined;

const maven =
  product.dependency && product.featuredVersion
    ? {
        ...product.dependency,
        productName: product.name,
        version: product.featuredVersion,
      }
    : undefined;

type InformationRow = {
  label: string;
  value?: string;
  href?: string;
  image?: string;
};

const information: InformationRow[] = [
  { label: "Compatibility", value: product.compatibility },
  { label: "Cost", value: product.cost },
  { label: "Language", value: product.language },
  { label: "Type", value: TYPE_LABELS[product.type] },
  { label: "Version", value: product.featuredVersion ?? product.version },
  { label: "Tags", value: product.tags?.join(", ") },
  {
    label: "Source",
    value: product.sourceUrl && new URL(product.sourceUrl).hostname,
    href: product.sourceUrl,
  },
  { label: "Status", image: product.statusBadgeUrl },
  {
    label: "More information",
    value: "Contact us",
    href: `https://www.axonivy.com/marketplace/contact/?market_solutions=${product.id}`,
  },
];
---

<Layout>
  <div class="flex flex-col gap-12">
    <Breadcrumb>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{product.name}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <div class="flex flex-row gap-8 justify-between items-center">
      <div class="flex flex-row gap-8 items-center">
        <img
          src={product.logo.src}
          alt={product.name}
          height={70}
          width={70}
          class={cn("rounded-md", product.logoDark && "dark:hidden")}
        />
        {product.logoDark && (
          <img
            src={product.logoDark.src}
            alt={product.name}
            height={70}
            width={70}
            class="rounded-md hidden dark:block"
          />
        )}
        <H1>{product.name}</H1>
      </div>
      <div class="flex flex-row gap-4 items-center">
        <Button className="h-12 px-6 text-base">Install Now</Button>
        {!product.mavenDropins && (
          <DownloadProduct
            artifacts={product.artifacts}
            mainArtifactId={product.mainArtifactId}
            client:load
          />
        )}
      </div>
    </div>
    <div class="flex flex-col gap-4">
      <H5>Type</H5>
      {product.type === "connector" && <IconPlug class="size-16 shrink-0" />}
      {product.type === "utils" && <IconTools class="size-16 shrink-0" />}
      {product.type === "demo" && (
        <IconClipboardCheck class="size-16 shrink-0" />
      )}
      <Base>{TYPE_LABELS[product.type]}</Base>
    </div>
    {product.deprecated && (
      <div class="flex flex-col gap-4 border border-info bg-info-bg p-4 rounded-md">
        <div class="flex flex-row gap-2 items-center">
          <IconAlertTriangle class="size-10 shrink-0" />
          <H3 className="uppercase">Deprecated</H3>
        </div>
        <Base>
          This extension is deprecated and will no longer receive updates or
          support.
        </Base>
      </div>
    )}
    <div class="flex flex-col gap-12 md:flex-row">
      <div class="flex md:w-2/3">
        <ProductDetails client:load readme={readme} maven={maven} />
      </div>
      <div class="flex flex-col gap-4 md:w-1/3">
        <H4>Information</H4>
        <Table className="w-full">
          <TableBody>
            <TableRow>
              <TableCell>Implemented by</TableCell>
              <TableCell className="text-right">
                <a
                  href={product.vendorUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {product.vendorImageFile ? (
                    <>
                      <img
                        src={product.vendorImageFile.src}
                        alt={product.vendor}
                        class={cn(
                          "ml-auto h-5 w-auto",
                          product.vendorImageDarkModeFile && "dark:hidden",
                        )}
                      />
                      {product.vendorImageDarkModeFile && (
                        <img
                          src={product.vendorImageDarkModeFile.src}
                          alt={product.vendor}
                          class="ml-auto h-5 w-auto hidden dark:block"
                        />
                      )}
                    </>
                  ) : (
                    <AxonIvyLogo class="ml-auto h-5 w-auto" />
                  )}
                </a>
              </TableCell>
            </TableRow>
            {information
              .filter((row) => row.value || row.image)
              .map(({ label, value, href, image }) => (
                <TableRow>
                  <TableCell>{label}</TableCell>
                  <TableCell className="text-right">
                    {image ? (
                      <img src={image} alt={label} class="ml-auto" />
                    ) : href ? (
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary underline"
                      >
                        {value}
                      </a>
                    ) : (
                      value
                    )}
                  </TableCell>
                </TableRow>
              ))}
          </TableBody>
        </Table>
      </div>
    </div>
  </div>
</Layout>
