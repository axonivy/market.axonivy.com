---
import { H1, H4, Base } from "@/components/ui/typography";
import Layout from "@/layouts/main.astro";
import Products from "@/components/products";
---

<Layout>
  <div class="flex flex-col gap-8">
    <H1>Axon Ivy Market</H1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <H4>
        The Axon Ivy Market offers a unique experience to accelerate process
        automation.
      </H4>
      <Base>
        Here you will find connectors to standard software solutions from
        leading providers such as Microsoft, Amazon, or Adobe, as well as
        ready-made process models, business solutions, and practical tools for
        document process, storage, or signing. <br /> Contribute to the
        community and{" "}
        <a
          href="https://github.com/axonivy-market/market/wiki"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary"
        >
          build your own market extension!
        </a>
      </Base>
    </div>
  </div>
  <Products client:load />
</Layout>
