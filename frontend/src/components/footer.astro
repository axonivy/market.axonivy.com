---
import AxonIvyDevLogo from "@/assets/axonivy-dev-logo.svg";
import Navbar from "@/components/navbar";
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import {
  IconBrandDocker,
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandYoutube,
} from "@tabler/icons-astro";
import { P } from "@/components/ui/typography";
import i18next, { type Lang } from "@/translation/ui";
import { getLanguageUrls } from "@/translation/urls";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = i18next.getFixedT(lang);
const languageUrls = getLanguageUrls(Astro.url);
const currentYear = new Date().getFullYear();
const [beforeLts, ltsText, betweenLinks, leadingEdgeText, afterLeadingEdge] =
  t("footer.info").split(/<a>|<\/a>/);

const footerContent = {
  copyright: `© ${currentYear} Axon Ivy Inc.`,
  downloadLink: "https://dev.axonivy.com/download",
  releaseLinks: {
    longTermSupport: "https://dev.axonivy.com/download",
    leadingEdge: "https://dev.axonivy.com/download",
  },
  website: { label: "www.axonivy.com", href: "https://www.axonivy.com" },
  legalLinks: [
    { label: "Privacy Policy", href: "https://www.axonivy.com/privacy-policy" },
    { label: "Legal Notice", href: "https://www.axonivy.com/legal-notice" },
  ],
  socialLinks: [
    {
      label: "LinkedIn",
      href: "https://ch.linkedin.com/company/axonivy",
      icon: IconBrandLinkedin,
    },
    {
      label: "Docker",
      href: "https://hub.docker.com/r/axonivy/axonivy-engine",
      icon: IconBrandDocker,
    },
    {
      label: "GitHub",
      href: "https://github.com/axonivy",
      icon: IconBrandGithub,
    },
    {
      label: "YouTube",
      href: "https://www.youtube.com/channel/UCkoNcDoeDAVM7FB-txy3jnQ",
      icon: IconBrandYoutube,
    },
  ],
};
---

<div class="border-n100 w-full border-t">
  <div class="relative mx-auto flex w-full flex-col gap-8 px-4 py-8 md:max-w-6xl">
    <div class="flex flex-col items-center gap-4 md:hidden">
      <a href="/">
        <AxonIvyDevLogo width={160} height={40} />
      </a>
      <div class="w-full max-w-md text-center">
        <P className="text-n900">
          {beforeLts}
          <a
            href={footerContent.releaseLinks.longTermSupport}
            class="text-primary underline"
          >
            {ltsText}
          </a>
          {betweenLinks}
          <a
            href={footerContent.releaseLinks.leadingEdge}
            class="text-primary underline"
          >
            {leadingEdgeText}
          </a>
          {afterLeadingEdge}
        </P>
      </div>
      <div>
        <a
          href={footerContent.downloadLink}
          class={buttonVariants({ variant: "default" })}
        >
          {t("common.download")}
        </a>
      </div>
    </div>

    <div class="hidden flex-col gap-4 md:flex">
      <div class="flex items-center justify-between">
        <a href="https://dev.axonivy.com/">
          <AxonIvyDevLogo width={160} height={40} />
        </a>
        <Navbar lang={lang} urls={languageUrls} client:load />
      </div>
      <div class="w-full max-w-md">
        <P className="text-n900">
          {beforeLts}
          <a
            href={footerContent.releaseLinks.longTermSupport}
            class="text-primary underline"
          >
            {ltsText}
          </a>
          {betweenLinks}
          <a
            href={footerContent.releaseLinks.leadingEdge}
            class="text-primary underline"
          >
            {leadingEdgeText}
          </a>
          {afterLeadingEdge}
        </P>
      </div>
      <div class="flex flex-row justify-between">
        <a
          href={footerContent.downloadLink}
          class={buttonVariants({ variant: "default" })}
        >
          {t("common.download")}
        </a>
        <a
          href={footerContent.website.href}
          class="text-primary underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          {footerContent.website.label}
        </a>
      </div>
    </div>

    <Separator />

    <div class="text-n900 flex flex-col items-center gap-6 text-sm md:hidden">
      <div class="flex flex-col items-center gap-2">
        <P>{footerContent.copyright}</P>
        <div class="flex gap-6">
          {footerContent.legalLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
      <a
        href={footerContent.website.href}
        class="text-primary underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        {footerContent.website.label}
      </a>
      <div class="flex flex-wrap items-center">
        <div class="flex gap-4">
          {footerContent.socialLinks.map((link) => {
            const SocialIcon = link.icon;

            return (
              <a
                href={link.href}
                aria-label={link.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <SocialIcon class="size-4.5" />
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="text-n900 hidden items-center justify-between text-sm md:flex">
      <div class="flex gap-6">
        <P>{footerContent.copyright}</P>
        {footerContent.legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-4">
        {footerContent.socialLinks.map((link) => {
          const SocialIcon = link.icon;

          return (
            <a
              href={link.href}
              aria-label={link.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <SocialIcon class="size-4.5" />
            </a>
          );
        })}
      </div>
    </div>
  </div>
</div>
