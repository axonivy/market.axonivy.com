---
import Navbar from "@/components/navbar";
import AxonIvyLogo from "@/assets/axonivy-logo-2021-rgb.svg";
import { ModeToggle } from "./ui/mode-toggle";
import { LanguageSwitcher } from "@/components/language-switcher";
import type { Lang } from "@/translation/ui";
import { getLanguageUrls } from "@/translation/urls";

const lang = (Astro.currentLocale ?? "en") as Lang;
const languageUrls = getLanguageUrls(Astro.url);
---

<script is:inline>
  (() => {
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

    const applyTheme = (theme) => {
      document.documentElement.classList.toggle("dark", theme === "dark");
    };

    const savedTheme = localStorage.getItem("theme");

    if (savedTheme === "dark") {
      applyTheme("dark");
    } else if (savedTheme === "light") {
      applyTheme("light");
    } else {
      applyTheme(mediaQuery.matches ? "dark" : "light");
    }

    mediaQuery.addEventListener("change", (event) => {
      if (
        !localStorage.getItem("theme") ||
        localStorage.getItem("theme") === "system"
      ) {
        applyTheme(event.matches ? "dark" : "light");
      }
    });
  })();
</script>

<div class="border-n100 bg-background fixed top-0 z-50 w-full border-b">
  <div class="relative mx-auto w-full px-4 py-4 md:max-w-6xl">
    <div class="flex w-full flex-row items-center justify-between gap-4">
      <a href="https://dev.axonivy.com/">
        <AxonIvyLogo width={108} height={16} class="md:h-10 md:w-40" />
      </a>
      <Navbar lang={lang} urls={languageUrls} client:load />
      <div class="hidden gap-2 md:flex items-center">
        <LanguageSwitcher client:load lang={lang} urls={languageUrls} />
        <ModeToggle client:load lang={lang} />
      </div>
    </div>
  </div>
</div>
