<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.1/phpunit.xsd" backupGlobals="false" colors="true" bootstrap="vendor/autoload.php">
  <coverage/>
  <php>
    <ini name="error_reporting" value="2"/>
    <env name="MARKET_PRODUCTS_DIR" value="src/web/_market" force="true"/>
    <env name="MARKET_CACHE_DIR" value="src/web/market-cache" force="true"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>test</directory>
      <exclude>test/permalink</exclude>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>./src/</directory>
    </include>
  </source>
</phpunit>
